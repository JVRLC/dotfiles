#!/bin/sh
# Machine-local guard: never let a Claude session link reach a commit message.
msg="$1"
if [ -f "$msg" ]; then
  grep -viE 'Claude-Session:|claude\.ai/code/session' "$msg" > "$msg.stripped" 2>/dev/null && mv "$msg.stripped" "$msg"
fi
common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || git rev-parse --git-common-dir 2>/dev/null)"
[ -x "$common/hooks/commit-msg" ] && exec "$common/hooks/commit-msg" "$@"
exit 0
